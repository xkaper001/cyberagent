# CyberAgents Backend Environment Configuration

APP_ENV=development
DEBUG=true
DEMO_MODE=true
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./cyberagents.db
# DATABASE_URL=postgresql://cyber_user:cyber_password@localhost:5432/cyberagents_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# LLM Provider Configuration (openai | anthropic | google | ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-2026-08
LLM_API_KEY=sk-demo-key-place-your-actual-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LangChain Observability (LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=cyberagents-copilot

# Security & Governance
JWT_SECRET=super-secret-cyberagents-jwt-key-2026
ALLOW_UNAUTHORIZED_TARGETS=false
DEFAULT_AUTHORIZED_SUBNET=10.10.14.0/24,192.168.10.0/24,127.0.0.1/32
